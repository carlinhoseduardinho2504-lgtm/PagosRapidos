{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagos-rapidos",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pagosrapidos",
      "database_id": "e5127702-b784-4d9a-8689-6fa6f8e5ba89"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "pagos-rapidos-files"
    }
  ]
}
