{
  "name": "pagos-rapidos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=pagosrapidos --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pagos-rapidos",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply pagosrapidos --local",
    "db:migrate:prod": "wrangler d1 migrations apply pagosrapidos",
    "db:seed": "wrangler d1 execute pagosrapidos --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "vite": "^5.4.0",
    "wrangler": "^3.78.0",
    "typescript": "^5.5.0"
  }
}
